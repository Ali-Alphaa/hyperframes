{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "audio-pulse",
  "type": "hyperframes:block",
  "title": "Audio Pulse",
  "description": "A glowing disc, or your logo, that swells and glows with the voice or music, with rings rippling out on loud moments. Transparent background. Driven by audio measured at install.",
  "tags": ["audio", "audio-reactive", "voice", "podcast", "logo", "pulse", "studio-pack"],
  "license": "Apache-2.0",
  "needs": ["audio"],
  "dimensions": { "width": 1920, "height": 1080 },
  "duration": 10,
  "variables": [
    { "id": "color", "type": "color", "label": "Glow colour", "default": "#2EBD85" },
    {
      "id": "logo",
      "type": "string",
      "label": "Logo image (project path, optional)",
      "default": ""
    },
    {
      "id": "size",
      "type": "number",
      "label": "Size",
      "default": 320,
      "min": 120,
      "max": 800,
      "unit": "px"
    },
    {
      "id": "amount",
      "type": "number",
      "label": "How much it reacts",
      "default": 0.35,
      "min": 0.05,
      "max": 1,
      "step": 0.05
    }
  ],
  "files": [
    {
      "path": "audio-pulse.html",
      "target": "compositions/audio-pulse.html",
      "type": "hyperframes:composition"
    }
  ]
}
